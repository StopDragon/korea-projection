[nemesis]
version=1.1
id=korea.projection
name=Korea Projection
type=service,application
package-version=1.5.1
short-desc="Enables wireless CarPlay on Korean Hyundai/Kia head units."
detailed-desc="순정 핫스팟이 켜지지 않는 한국 차에서 무선 카플레이를 켭니다. 확인된 차(기아 니로 하이브리드 DEPEHEV.KOR 260902, 현대 쏘나타 하이브리드 DN822HEV.KOR 260902)에서는 HMG-API 무선 모드와 그 차의 지도가 없으면 자동으로 설치합니다. 다른 차는 대기만 합니다. HMG-API가 필요합니다. Launch: 상태 화면과 제보용 QR."
os="DEPEHEV.KOR.*.260902"
models="*_kr"
depends="!niro.carplay.hotspot"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[app.1]
component=korea.projection.app/.StatusActivity

[service.0]
name=ap
kind=sh
path=svc/hotspot.sh
uid=root
mode=restart
